# =============================================================================
# AndroidWorld AgentRuntime Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# You can also use .env.local to override values locally (not committed to git).
#
# Priority order: OS environment > .env.local > .env
# =============================================================================


# -----------------------------------------------------------------------------
# E2B / AgentRuntime Connection
# -----------------------------------------------------------------------------

# E2B API key (required)
E2B_API_KEY=your_e2b_api_key_here

# E2B domain for self-hosted or custom deployments (optional)
# Leave unset to use the default E2B cloud.
# E2B_DOMAIN=your.e2b.domain.com


# -----------------------------------------------------------------------------
# Sandbox Settings
# -----------------------------------------------------------------------------

# Sandbox template ID to use when creating new sandboxes (required unless
# using sandboxes.yaml with pre-created sandbox IDs)
SANDBOX_TEMPLATE=your_template_id_here

# Sandbox lifetime in seconds (default: 300)
SANDBOX_TIMEOUT=300

# Number of sandboxes to create for parallel execution (default: 1)
SANDBOX_COUNT=1


# -----------------------------------------------------------------------------
# Execution Settings
# -----------------------------------------------------------------------------

# Execution mode: serial | parallel (default: serial)
# When using --sandboxes_yaml flag, this is set automatically to parallel.
EXECUTION_MODE=serial

# Number of worker threads per process (default: 4)
THREAD_POOL_SIZE=4

# Number of processes (default: 1)
PROCESS_COUNT=1


# -----------------------------------------------------------------------------
# LLM API Keys
# -----------------------------------------------------------------------------

# OpenAI API key (required for GPT-based agents)
OPENAI_API_KEY=your_openai_api_key_here

# Google Cloud API key (optional, for Gemini-based agents)
# GCP_API_KEY=your_gcp_api_key_here
